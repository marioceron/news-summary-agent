# --- Required  variables---
LIST_NEWS_OUTLETS=https://www.reuters.com;https://www.bbc.com/sport;https://www.eltiempo.com
# LIST_NEWS_OUTLETS=https://apnews.com;https://www.theguardian.com/world;https://www.theguardian.com/business;https://www.aljazeera.com;https://www.cnbc.com/world/;https://www.elespectador.com;https://www.portafolio.co;https://www.larepublica.co;https://elpais.com;https://www.espn.com;https://www.skysports.com;https://www.marca.com
SEND_TO=username@gmail.com
INTEREST_TOPICS=politics;business;sports
USER_NAME=username       # used in Azure path + state folder default
YOUR_NAME_FOR_SUBJECT=Mario Ceron  # "News summary by {your_name} agent"

# Azure Storage settings
# AZURE_STORAGE_ACCOUNT_NAME=newssummaryagent
# AZURE_STORAGE_ACCOUNT_KEY==*******************************************;
# AZURE_CONTAINER_NAME=news-extracts
# AZURE_FOLDER_NAME=useranme

AZURE_STORAGE_ACCOUNT_NAME=datanews2025
AZURE_STORAGE_ACCOUNT_KEY==*******************************************;
AZURE_CONTAINER_NAME=datanews
AZURE_FOLDER_NAME=username

# --- Azure Blob Storage (use either connection string or account key) ---
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=${AZURE_STORAGE_ACCOUNT_NAME};AccountKey=${AZURE_STORAGE_ACCOUNT_KEY};EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=datanews2025;AccountKey=****************************************;EndpointSuffix=core.windows.net

# SMTP settings
SMTP_USER=username@gmail.com
# SMTP_USER=username@gmail.com
SMTP_PASSWORD=**************
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SEND_TO=username_sent@gmail.com
# SEND_TO=username@gmail.com
EMAIL_FROM="News Agent <username@gmail.com>"
SMTP_USE_SSL=true
SMTP_USE_TLS=false
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_DEBUG=1
DRY_RUN_EMAIL=false

# --- LLM (for summarization) ---
OPENAI_API_KEY=sk-...
OPENAI_TRANSLATE_MODEL=gpt-4o-mini
# NEW: set a default timeout (seconds) and 1 quick retry
_OPENAI_TIMEOUT = 15
_OPENAI_RETRIES = 1

# --- Airflow web UI login (compose file also seeds admin/admin) ---
# Airflow settings
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_EMAIL=admin@example.com

# -- Select relevant articles ---
EMBED_BATCH_SIZE=32
CLASSIFY_BODY_MAX=1000
SBERT_MAX_SEQ_LEN=256
MAX_CLASSIFY_ARTICLES=200
TOPIC_SIM_THRESHOLD=0.20
DEFAULT_EN_DOMAINS=reuters.com;apnews.com;bbc.com;theguardian.com;cnbc.com;espn.com;skysports.com;aljazeera.com

# --- Host state directory (optional override) ---
HOST_STATE_DIR=/tmp/username/hackathon

STATE_DB_URL=postgresql+psycopg2://admin:admin@db:5432/airflow
